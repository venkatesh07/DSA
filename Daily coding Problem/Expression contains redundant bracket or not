Given a string of balanced expression s, check if it contains a redundant parenthesis or not. A set of parenthesis are redundant if the same sub-expression is surrounded by unnecessary or multiple brackets.
Note: Expression may contain + , - , *, and / operators. Given expression is valid and there are no white spaces present.

Examples:

Input: s = "((a+b))"
Output: true 
Explanation: ((a+b)) can reduced to (a+b).

Code:
class Solution {
    public static boolean checkRedundancy(String s) {
        Stack<Character> st = new Stack<>(); // to track bracket and operators
        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            if(ch==')'){
                if(st.peek()=='(') return true; // immediate closed bracked with a operator inside in it
                while(st.peek()!='('){
                    st.pop(); // pop till we get '('
                }
                st.pop(); // pop '('
            }else if(ch=='(' || ch=='+' || ch=='-' || ch=='/' || ch=='*'){
                st.push(ch); // push if char is either '(' or operators to keep track
            }
        }
        return false; // no immediate brackets => not redundant
    }
}
