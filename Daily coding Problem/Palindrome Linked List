You are given the head of a singly linked list of positive integers. You have to check if the given linked list is palindrome or not.
Examples:

Input:
Output: true
Explanation: The given linked list is 1 -> 2 -> 1 -> 1 -> 2 -> 1, which is a palindrom
code:
class Solution {
    // Function to check whether the list is palindrome.
    boolean isPalindrome(Node head) {
        
        List<Integer> li = new LinkedList<>();
        
        if(head == null) return true;
        
        Node temp = head;
        
        while(temp != null){
            li.add(temp.data);
            temp = temp.next;
        }
        int l = 0, r = li.size()-1;
        
        while(l < r){
            if(!li.get(l).equals(li.get(r))){
                return false;
            }
            l++;
            r--;
        }
        return true;
        
    }
}
