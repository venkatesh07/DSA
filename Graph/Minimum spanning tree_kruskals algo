class Solution {
    static class Disjointset{
        int[] parent, rank;
        Disjointset(int n){
            parent = new int[n];
            rank = new int[n];
            for(int i=0;i<n;i++){
                rank[i] = 0;
                parent[i] = i;
            }
        }
        int find(int x){
            if(parent[x] != x){
                parent[x] = find(parent[x]);
            }
            return parent[x];
        }
        void union(int x, int y){
            int px = find(x);
            int py = find(y);
            
            if(px == py) return;
            
            if(rank[px] < rank[py]){
                parent[px] = py;
            }else if(rank[px] > rank[py]){
                parent[py] = px;
            }else{
                parent[py] = px;
                rank[px]++;
            }
        }
    }
    public int spanningTree(int V, int[][] edges) {
        // code here
        
        Arrays.sort(edges, (a, b) -> a[2] - b[2]);
        
        Disjointset ds = new Disjointset(V);
        int mstweight = 0;
        int edgesweight = 0;
        
        for(int[] edge:edges){
            int u = edge[0];
            int v = edge[1];
            int wt = edge[2];
            
            int pu = ds.find(u);
            int pv = ds.find(v);
            
            if(pu != pv){
                ds.union(u, v);
                mstweight += wt;
                edgesweight++;
            }
            if(edgesweight == V-1) break;
            
        }
        return mstweight;
    }
}
